# Salin file ini menjadi .env lalu isi API key. JANGAN commit file .env.
# Nama model mengikuti format litellm: <provider>/<model>, contoh:
#   gemini/gemini-3.5-flash, groq/openai/gpt-oss-120b, anthropic/claude-sonnet-5-5
LLM_PROVIDER=gemini
LLM_MODEL=groq/openai/gpt-oss-120b            # Director & Critic (teks)
VISION_MODEL=gemini/gemini-3.1-flash-lite     # Describe (butuh model yang bisa melihat gambar)
# Model cadangan otomatis bila model utama overload/timeout
LLM_FALLBACK_MODEL=gemini/gemini-3.5-flash-lite,runcrate/openai/gpt-oss-120b,cohere_chat/command-a-plus-05-2026   # dicoba berurutan bila model utama kena limit
VISION_FALLBACK_MODEL=gemini/gemini-3.5-flash-lite,cohere_chat/command-a-vision-07-2025,groq/qwen/qwen3.8-27b
# Voice over suara AI (Gemini TTS). Free tier: 10 permintaan/hari/model (1 permintaan = 1 video).
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_FALLBACK_MODEL=gemini-2.5-flash-preview-tts

# --- Opsional: model lokal via Ollama (uji coba di laptop ber-GPU; pilih "Lokal" di web atau --engine local) ---
# Pasang Ollama, lalu: ollama pull qwen3:4b && ollama pull qwen3-vl:4b-instruct  (pakai varian -instruct: tag polos qwen3-vl:4b adalah versi "thinking", lambat)
LOCAL_LLM_MODEL=ollama/qwen3:4b          # Director & caption (teks). qwen3:8b tidak muat penuh di VRAM 6 GB (sangat lambat)
LOCAL_VISION_MODEL=ollama/qwen3-vl:4b-instruct    # Describe (gambar)
OLLAMA_API_BASE=http://127.0.0.1:11434
LOCAL_NUM_CTX=8192                       # panjang konteks; makin besar makin banyak VRAM

GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Transkripsi ucapan (Tahap 3, faster-whisper di CPU). Model diunduh sekali saat pertama dipakai.
TRANSCRIBE_MODEL=small                   # tiny | base | small | medium (makin besar makin akurat & lambat)

# Opsional: lokasi ffmpeg bila tidak ada di PATH
FFMPEG_BIN=ffmpeg

# --- Tahap 6: koneksi Instagram (API resmi Meta) ---
# Akun tujuan posting: test (akun decoy, default) atau production (@contohbrand)
IG_TARGET=test

# Akun decoy untuk uji coba (harus akun Profesional juga)
IG_TEST_USER_ID=
IG_TEST_ACCESS_TOKEN=

# Akun produksi @contohbrand
IG_USER_ID=
IG_ACCESS_TOKEN=
COHERE_API_KEY=            # cadangan teks & vision (cohere_chat/...)
RUN_CRATE_API_KEY=            # cadangan teks, gerbang OpenAI-compatible (runcrate/<id>)
AIONLABS_API_KEY=            # aionlabs/<id>; butuh kartu terverifikasi
DEEPSEEK_API_KEY=            # opsional
